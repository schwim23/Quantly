# Quantly — API Keys
# Copy this file to .env and fill in your keys before running.

# Price / OHLCV (free tier: 100 req/day, $7/mo for more)
TIINGO_API_KEY=

# Fundamentals + Earnings calendars + transcripts (free: 250 req/day)
FMP_API_KEY=

# AI-scored news sentiment (free tier)
ALPHA_VANTAGE_API_KEY=

# Earnings + economic catalyst calendar (free tier)
FINNHUB_API_KEY=

# Congressional trades + options flow (free tier)
QUIVER_API_KEY=

# Optional: Unusual Whales paid tier ($50/mo) — falls back to Quiver if not set
UNUSUAL_WHALES_API_KEY=

# Reserved for future Claude analyst integration
ANTHROPIC_API_KEY=

# ── Strategy overrides (optional) ────────────────────────────────────────────
PORTFOLIO_VALUE=10000
MAX_POSITIONS=15
DATA_DIR=data
