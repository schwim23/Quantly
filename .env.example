# Quantly — API Keys
# Copy this file to .env and fill in your credentials

# Required
ANTHROPIC_API_KEY=

# Market data (at least one required)
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Optional — professional Bloomberg access
BLOOMBERG_API_KEY=

# Reddit sentiment (optional)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=quantly/0.1

# Settings
QUANTLY_UNIVERSE=all_us          # all_us | sp500 | nasdaq100
QUANTLY_MIN_VOLUME=500000        # minimum avg daily volume filter
QUANTLY_TOP_N_FOR_CLAUDE=20      # how many ML picks to send to Claude
QUANTLY_CACHE_DIR=data/cache     # local cache directory
QUANTLY_DB_PATH=data/paper_trades.db
