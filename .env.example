# Quantly — environment configuration
# Copy to .env and fill in values

# ── Required ──────────────────────────────────────────
ANTHROPIC_API_KEY=          # claude.ai → Settings → API Keys

# ── Optional: Reddit sentiment ────────────────────────
# Register a free app at https://www.reddit.com/prefs/apps
# Type: "script"  |  Redirect URI: http://localhost:8080
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=quantly/0.1 (by /u/your_username)

# ── Pipeline settings (safe to leave as defaults) ─────
QUANTLY_UNIVERSE=sp500          # sp500 | nasdaq100 | all_us
QUANTLY_MIN_VOLUME=500000       # minimum avg daily volume
QUANTLY_TOP_N_FOR_CLAUDE=20     # top ML candidates sent to Claude
QUANTLY_CACHE_TTL=86400         # cache TTL in seconds (24h default)
QUANTLY_CACHE_DIR=data/cache
QUANTLY_DB_PATH=data/paper_trades.db
